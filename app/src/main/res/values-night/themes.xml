<resources
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Grocerly" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your theme here -->
        <item name="colorPrimary">@color/green</item>
        <item name="colorPrimaryContainer">@color/green</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="fontFamily">@font/custom_font</item>
        <item name="editTextColor">@color/black</item>
        <item name="textFillColor">@color/black</item>

        <item name="android:windowLightStatusBar">true</item>

    </style>


    <style name="CustomPopupMenuStyle" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_menu_background</item>
    </style>


    <style name="Theme.Grocerly" parent="Base.Theme.Grocerly" />
</resources>
